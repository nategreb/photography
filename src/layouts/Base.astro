---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Photography by Nate Grebelsky' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="site-nav" id="site-nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">Nate Grebelsky</a>
        <div class="nav-links">
          <slot name="nav-links">
            <a href="/#thailand">Thailand</a>
            <a href="/#washington">Washington</a>
            <a href="/#peru">Peru</a>
            <a href="/about">About</a>
          </slot>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>&copy; {new Date().getFullYear()} Nate Grebelsky</p>
        <div class="footer-links">
          <a href="https://www.instagram.com/nategreb" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.linkedin.com/in/nate-grebelsky/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/nategreb" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.strava.com/athletes/121131618" target="_blank" rel="noopener">Strava</a>
        </div>
      </div>
    </footer>

    <slot name="scripts" />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
